# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas - mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/urbanfarming

# Groq - free at console.groq.com
GROQ_API_KEY=gsk_...

# Google Gemini - free at aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Hugging Face - free at huggingface.co/settings/tokens
HF_API_KEY=hf_...

# Cloudinary - free at cloudinary.com (optional, for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Trefle plant API - trefle.io (optional)
TREFLE_API_TOKEN=

# data.gov.in API (optional, for government plot data)
GOVT_DATA_API_KEY=
